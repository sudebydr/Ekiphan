# Public frontend
NEXT_PUBLIC_API_BASE_URL=https://localhost:7064
# Canonical production origin. HTTPS only; leave empty until the public domain is approved.
EKIPHAN_SITE_URL=
# Approved KVKK notice page; use an on-site path or absolute HTTPS URL.
NEXT_PUBLIC_KVKK_NOTICE_URL=
# Optional approved external showroom tour. Server-only, absolute HTTPS URL.
SHOWROOM_TOUR_URL=
# Server-only URL used by the Next.js admin BFF. Do not expose bearer tokens.
EKIPHAN_API_BASE_URL=https://localhost:7064
# Public HTTPS origin/path where validated media storage keys are served.
PublicMedia__BaseUrl=https://cdn.example.com/ekiphan/
# Media examples (use the AWS SDK default credential chain; never place access keys here).
MediaStorage__Provider=S3
MediaStorage__S3__Bucket=ekiphan-product-media
MediaStorage__S3__Region=eu-north-1
# MediaStorage__S3__Prefix=

# Backend
ASPNETCORE_ENVIRONMENT=Development

# Supply real values through a local secret store or environment variables.
ConnectionStrings__EkiphanDatabase=
ConnectionStrings__Redis=
Authentication__Jwt__Issuer=
Authentication__Jwt__Audience=
Authentication__Jwt__SigningKey=
Authentication__Jwt__AccessTokenMinutes=15
Authentication__Jwt__IdleTimeoutMinutes=30
# One-time first admin creation. Remove these values after the first successful start.
Authentication__Bootstrap__Email=
Authentication__Bootstrap__DisplayName=
Authentication__Bootstrap__Password=
QuoteConsent__KvkkVersion=
QuoteConsent__CommercialCommunicationVersion=
Email__Host=
Email__UserName=
Email__Password=

# Temporary frontend catalog mode; set true only until real products are imported.
NEXT_PUBLIC_USE_DEMO_PRODUCTS=false
